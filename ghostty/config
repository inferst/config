config-file = ?auto/theme.ghostty

# Font
# font-family = GohuFont uni14 Nerd Font Mono
font-family = IosevkaTerm Nerd Font Mono
font-style-italic = false
font-style-bold-italic = false
font-size = 20
font-thicken = true
font-thicken-strength = 50
font-synthetic-style = no-bold

# Cursor
cursor-style = block
mouse-hide-while-typing = true

# Bell
bell-features = no-audio

# macOS
macos-option-as-alt = true
quit-after-last-window-closed = true
macos-titlebar-style = tabs
maximize = true

# Notifications
notify-on-command-finish-action = notify

# Custom Shaders
# custom-shader = shaders/cursor_sweep.glsl
# custom-shader = shaders/sonic_boom_cursor.glsl
# custom-shader = ghostty-shaders/drunkard.glsl
